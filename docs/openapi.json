  "components": {
    "schemas": {
      "Assessment": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "risk": {
            "type": "string",
            "enum": [
              "LOW",
              "MEDIUM",
              "HIGH"
            ],
            "title": "Risk"
          },
          "score": {
            "type": "integer",
            "title": "Score"
          },
          "score_type": {
            "type": "string",
            "title": "Score Type",
            "default": "heuristic_indicator_score"
          },
          "model_probability": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Probability"
          },
          "engine": {
            "type": "string",
            "title": "Engine",
            "default": "explainable-rules-v1"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "category": {
            "type": "string",
            "title": "Category"
          },
          "indicators": {
            "items": {
              "$ref": "#/components/schemas/Indicator"
            },
            "type": "array",
            "title": "Indicators"
          },
          "recommendations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations"
          },
          "recommendations_ms": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Recommendations Ms"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer"
          },
          "disclaimer_ms": {
            "type": "string",
            "title": "Disclaimer Ms"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "domain": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Domain"
          },
          "threat_intelligence": {
            "type": "string",
            "title": "Threat Intelligence",
            "default": "not_configured"
          }
        },
        "type": "object",
        "required": [
          "id",
          "risk",
          "score",
          "language",
          "category",
          "indicators",
          "recommendations",
          "recommendations_ms",
          "disclaimer",
          "disclaimer_ms",
          "created_at"
        ],
        "title": "Assessment"
      },
      "Body_scan_image_api_v1_scan_image_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_scan_image_api_v1_scan_image_post"
      },
      "Credentials": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "minLength": 5,
            "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 10,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "Credentials"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Indicator": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "title_ms": {
            "type": "string",
            "title": "Title Ms"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "explanation_ms": {
            "type": "string",
            "title": "Explanation Ms"
          },
          "weight": {
            "type": "integer",
            "title": "Weight"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "title_ms",
          "explanation",
          "explanation_ms",
          "weight"
        ],
        "title": "Indicator"
      },
      "NoticeInput": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 160,
            "minLength": 3,
            "title": "Title"
          },
          "body": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 3,
            "title": "Body"
          }
        },
        "type": "object",
        "required": [
          "title",
          "body"
        ],
        "title": "NoticeInput"
      },
      "PreferencesInput": {
        "properties": {
          "dashboard_days": {
            "type": "integer",
            "enum": [
              7,
              30
            ],
            "title": "Dashboard Days",
            "default": 30
          }
        },
        "type": "object",
        "title": "PreferencesInput"
      },
      "QuizInput": {
        "properties": {
          "module_id": {
            "type": "string",
            "title": "Module Id"
          },
          "answers": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "maxItems": 10,
            "minItems": 1,
            "title": "Answers"
          },
          "stage": {
            "type": "string",
            "enum": [
              "pre",
              "post"
            ],
            "title": "Stage",
            "default": "post"
          }
        },
        "type": "object",
        "required": [
          "module_id",
          "answers"
        ],
        "title": "QuizInput"
      },
      "ScanInput": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 3,
            "title": "Text"
          },
          "save_history": {
            "type": "boolean",
            "title": "Save History",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "ScanInput"
      },
      "URLInput": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 4,
            "title": "Url"
          },
          "save_history": {
            "type": "boolean",
            "title": "Save History",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "URLInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}