ENVIRONMENT=development
DATABASE_URL=sqlite:///./scamshield.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
HISTORY_RETENTION_DAYS=30
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_PORT=8081
TESSERACT_CMD=
OCR_LANGUAGES=eng
PHISHTANK_APP_KEY=
PHISHTANK_USER_AGENT=phishtank/scamshield-ai
# Optional. Each artifact requires a separately reviewed, validated report with
# matching SHA-256 and an evidence-based threshold_policy before activation.
ML_MESSAGE_ARTIFACT=
ML_MESSAGE_REPORT=
ML_URL_ARTIFACT=
ML_URL_REPORT=
# Docker-only options. Set a strong URL-safe password for PostgreSQL.
POSTGRES_PASSWORD=
DOCKER_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Vercel: set ENVIRONMENT=production and DATABASE_URL to a managed PostgreSQL
# connection string in Project Settings. Do not use SQLite for serverless storage.
